@baseUrl = http://localhost:3000

###############################################
# AUTH — los doce casos del Paso 12
###############################################

### 1 - Registro (201, sin passwordHash en la respuesta)
POST {{baseUrl}}/api/auth/registro
Content-Type: application/json

{ "nombre": "Ana", "email": "ana@libreria.test", "password": "Libreria2026" }

### 2 - Registro con el mismo email (409)
POST {{baseUrl}}/api/auth/registro
Content-Type: application/json

{ "nombre": "Ana", "email": "ana@libreria.test", "password": "Libreria2026" }

### 3 - Registro con password "corta" (400 con los 3 errores)
POST {{baseUrl}}/api/auth/registro
Content-Type: application/json

{ "nombre": "Ana", "email": "ana2@libreria.test", "password": "abc" }

### 4 - Login con mail que no existe (401 "Credenciales inválidas")
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "noexiste@libreria.test", "password": "Libreria2026" }

### 5 - Login con password mal (401, el mismo mensaje que el caso 4)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "ana@libreria.test", "password": "otraCosa1" }

### 6 - Login correcto (200 con token)
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "ana@libreria.test", "password": "Libreria2026" }

### Guardamos el token de Ana (CLIENTE)
@token = {{login.response.body.token}}

### Login como ADMIN (seed) — para los casos de escritura
# @name loginAdmin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "admin@libreria.test", "password": "Admin1234" }

### Guardamos el token de ADMIN
@adminToken = {{loginAdmin.response.body.token}}

### 7 - GET /auth/yo sin header (401)
GET {{baseUrl}}/api/auth/yo

### 8 - GET /auth/yo con CLIENTE (200)
GET {{baseUrl}}/api/auth/yo
Authorization: Bearer {{token}}

### 9 - POST /api/libros sin header (401)
POST {{baseUrl}}/api/libros
Content-Type: application/json

{ "titulo": "Sin token", "precio": 5000, "imagen": "https://covers.openlibrary.org/b/id/0-L.jpg", "autorId": 1 }

### 10 - POST /api/libros con CLIENTE (403)
POST {{baseUrl}}/api/libros
Content-Type: application/json
Authorization: Bearer {{token}}

{ "titulo": "Con cliente", "precio": 5000, "imagen": "https://covers.openlibrary.org/b/id/0-L.jpg", "autorId": 1 }

### 11 - POST /api/libros con ADMIN (201)
POST {{baseUrl}}/api/libros
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "titulo": "Con admin", "precio": 5000, "imagen": "https://covers.openlibrary.org/b/id/0-L.jpg", "autorId": 1 }

### 12 - GET /api/libros sin header (200, es público)
GET {{baseUrl}}/api/libros

### Rompé el token: cambiale un caracter al payload y probá /auth/yo -> 401 "Token inválido"
# GET {{baseUrl}}/api/auth/yo
# Authorization: Bearer eyJhbGci....PAYLOAD-MODIFICADO....firma

###############################################
# LIBROS — CRUD con relaciones, protegido para ADMIN
###############################################

### Listar libros (con su autor incluido)
GET {{baseUrl}}/api/libros

### Listar solo los disponibles
GET {{baseUrl}}/api/libros?disponible=true

### Ver un libro (con autor y categorías)
GET {{baseUrl}}/api/libros/1

### 404 - un libro que no existe
GET {{baseUrl}}/api/libros/999

### 400 - id inválido (no es un número)
GET {{baseUrl}}/api/libros/abc

### 400 - crear un libro sin título (con ADMIN)
POST {{baseUrl}}/api/libros
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "precio": 5000,
  "imagen": "https://covers.openlibrary.org/b/id/0-L.jpg",
  "autorId": 1
}

### 409 - crear un libro con un autor que no existe (FK inválida, con ADMIN)
POST {{baseUrl}}/api/libros
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "titulo": "Huérfano",
  "precio": 5000,
  "imagen": "https://covers.openlibrary.org/b/id/0-L.jpg",
  "autorId": 9999
}

### Editar un libro (con ADMIN)
PUT {{baseUrl}}/api/libros/1
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "precio": 30000
}

### 404 - editar un libro que no existe (con ADMIN)
PUT {{baseUrl}}/api/libros/999
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "precio": 1000
}

### Borrar un libro (con ADMIN)
DELETE {{baseUrl}}/api/libros/2
Authorization: Bearer {{adminToken}}

### 404 - borrar un libro que no existe (con ADMIN)
DELETE {{baseUrl}}/api/libros/999
Authorization: Bearer {{adminToken}}

###############################################
# AUTORES — CRUD, protegido para ADMIN
###############################################

### Listar autores
GET {{baseUrl}}/api/autores

### Ver un autor
GET {{baseUrl}}/api/autores/1

### 404 - un autor que no existe
GET {{baseUrl}}/api/autores/999

### Crear un autor (con ADMIN)
POST {{baseUrl}}/api/autores
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "nombre": "Julio Cortázar",
  "nacionalidad": "Argentina"
}

### 409 - crear un autor con nombre duplicado (con ADMIN)
POST {{baseUrl}}/api/autores
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "nombre": "Gabriel García Márquez",
  "nacionalidad": "Colombia"
}

### Editar un autor (con ADMIN)
PUT {{baseUrl}}/api/autores/1
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "nacionalidad": "Colombiana"
}

### 404 - editar un autor que no existe (con ADMIN)
PUT {{baseUrl}}/api/autores/999
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "nacionalidad": "x"
}

### 409 - borrar un autor que tiene libros (onDelete: Restrict, con ADMIN)
DELETE {{baseUrl}}/api/autores/1
Authorization: Bearer {{adminToken}}

### 404 - borrar un autor que no existe (con ADMIN)
DELETE {{baseUrl}}/api/autores/999
Authorization: Bearer {{adminToken}}
